YOUCAM_API_KEY=
CORS_ORIGINS=http://localhost:5173
# 1 (the default when unset) = replay recorded scans from backend/fixtures, no units spent.
# Set 0 here for local live scans (they also need LIVE_SCAN_PASSCODE below).
DEMO_MODE=1
# Refuse live scans when the balance is below this many units
YOUCAM_UNIT_RESERVE=200
# The real cap for live scans: never send a scan that would leave the YouCam balance below this.
# Set it to (your balance at deploy time) minus (the units you'll allow). Unset = YOUCAM_UNIT_RESERVE.
LIVE_SCAN_MIN_BALANCE=

# Live scans need DEMO_MODE=0 AND this passcode, entered on the app's Learn page.
# Leave empty to make live scans impossible.
LIVE_SCAN_PASSCODE=
# Scans per client IP per window: <count>/<seconds>. 0 = off.
SCAN_RATE_LIMIT=30/600
# 1 behind a proxy (Render) so the rate limit sees the real client IP.
TRUST_PROXY=0
# 1 = seed the demo persona's routine when the database is empty.
DERMOS_SEED=0
# SQLite file and saved-mask folder (defaults: backend/dermos.db, backend/media).
# DERMOS_DB=
# DERMOS_MEDIA=

# Optional language layer (intake suggestions + plain-language explanations). Off by default;
# the app works fully without it. Runs on a local Ollama server only: no API key.
#   ollama pull gemma4:e4b     (any chat model works; set LLM_MODEL to its name)
# none | ollama
LLM_PROVIDER=none
# Defaults: http://127.0.0.1:11434/v1 and gemma4:e4b
# LLM_BASE_URL=
# LLM_MODEL=
# Seconds per call (one retry). Ollama's default is 120: a local model on a laptop CPU is slow.
# LLM_TIMEOUT=
