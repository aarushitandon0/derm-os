YOUCAM_API_KEY=
CORS_ORIGINS=http://localhost:5173
# 1 = replay recorded scans from backend/fixtures (no units spent)
DEMO_MODE=0
# Refuse live scans when the balance is below this many units
YOUCAM_UNIT_RESERVE=100

# Live scans need DEMO_MODE=0 AND this passcode, entered on the app's Learn page.
# Leave empty to make live scans impossible.
LIVE_SCAN_PASSCODE=
# Scans per client IP per window: <count>/<seconds>. 0 = off.
SCAN_RATE_LIMIT=30/600
# 1 behind a proxy (Render) so the rate limit sees the real client IP.
TRUST_PROXY=0
# 1 = seed the demo persona's routine when the database is empty.
DERMOS_SEED=0
# SQLite file and saved-mask folder (defaults: backend/dermos.db, backend/media).
# DERMOS_DB=
# DERMOS_MEDIA=

# Optional language layer (intake suggestions + plain-language explanations). Off by default;
# the app works fully without it. none | anthropic | openai_compatible
LLM_PROVIDER=none
# anthropic: key required; model optional (default claude-haiku-5-5)
ANTHROPIC_API_KEY=
# openai_compatible (Groq, Gemini's OpenAI endpoint, local Ollama at http://127.0.0.1:11434/v1):
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Seconds per LLM call (one retry on failure).
# LLM_TIMEOUT=12
